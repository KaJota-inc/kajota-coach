# kajota-coach — env vars consumed by app.config.js at build time.
# Copy this to .env and fill in real values (.env is gitignored).

# RevenueCat client SDK keys — one per platform.
# Get them from RC Dashboard → Project Settings → API keys → Public app-specific.
# Test Store is active by default until real ASC/Play products are wired.
#
# iOS starts with appl_...
REVENUECAT_IOS_KEY=

# Android starts with goog_...
REVENUECAT_ANDROID_KEY=
